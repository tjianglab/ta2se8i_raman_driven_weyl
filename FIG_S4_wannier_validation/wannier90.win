write_hr = True
write_xyz = True
translate_home_cell = False

spinors = True

num_bands         =   180      
num_wann          =   148

dis_win_max       =  10.00d0
dis_win_min       = -14.00d0
dis_froz_max      =  10.00d0
dis_froz_min      =   0.00d0
dis_num_iter     = 10000      ! 最大迭代步数
dis_mix_ratio    = 0.5d0     ! 每一步更新的混合比例
dis_conv_tol     = 1.0d-8    ! Ω_I 收敛阈值
dis_conv_window  = 5         ! 需连续满足的步数
!fermi is 6.7669
num_iter          = 200
num_print_cycles  = 20


!! !! Bond-centred s-orbitals
begin projections 
Ta:d
Se:p
I:p
end projections

!! To plot the WFs
! restart                =  plot
!wannier_plot           =  true
!wannier_plot_supercell =  3
! wannier_plot_list      =  1,5


!! To plot the WF interpolated bandstructure
bands_plot      =  true
